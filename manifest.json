{
  "name": "Mimick — read PDFs aloud",
  "short_name": "Mimick",
  "description": "A PDF reader that reads aloud in natural voices, with each word lit as it is spoken. Everything stays on your computer.",
  "start_url": "reader.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101216",
  "theme_color": "#191d24",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "reader.html", "accept": { "application/pdf": [".pdf"], "text/plain": [".txt"],
                  "text/markdown": [".md"], "text/html": [".html", ".htm"],
                  "application/xhtml+xml": [".xhtml"], "application/rtf": [".rtf"],
                  "application/x-fictionbook+xml": [".fb2"],
                  "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
                  "application/vnd.oasis.opendocument.text": [".odt"], "application/epub+zip": [".epub"],
                  "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
                  "application/vnd.openxmlformats-officedocument.presentationml.slideshow": [".ppsx"],
                  "application/vnd.oasis.opendocument.presentation": [".odp"] } }
  ]
}
